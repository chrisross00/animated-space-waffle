# Frontend environment — copy to `frontend/.env` and fill in. The real file is gitignored.

VITE_SENTRY_DSN=
# Set to 1 in dev to show the "Login as test user" bypass button (absent in prod).
VITE_DEV_AUTH_BYPASS=

# --- Teller Connect ---
# applicationId is public; environment matches the backend (use `development`).
VITE_TELLER_APPLICATION_ID=app_xxxxxxxx
VITE_TELLER_ENVIRONMENT=development
