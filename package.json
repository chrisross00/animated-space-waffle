{
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "nodemon index.js",
    "dev": "concurrently -n api,app,admin -c blue,green,magenta \"npm start\" \"npm run dev --prefix frontend\" \"npm run dev --prefix admin\"",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix admin",
    "test": "vitest run --config vitest.config.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "mongodb": "^5.1.0",
    "plaid": "^41.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "vitest": "^4.0.18"
  }
}
