# Backend environment — copy to `.env` and fill in. The real `.env` is gitignored.

# --- Database ---
DATABASE_URL=postgresql://chris@localhost/basil

# --- Auth (Google OAuth2 → self-issued JWT) ---
JWT_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Error tracking ---
SENTRY_DSN=

# --- Teller (bank data provider) ---
# Use the free `development` environment. The cert + key are issued by Teller and
# live OUTSIDE the repo (locally ~/.teller/, on the VPS /opt/basil/certs/, chmod 600).
# applicationId is the CN on the certificate.
TELLER_APPLICATION_ID=app_xxxxxxxx
TELLER_ENVIRONMENT=development
TELLER_CERT_PATH=/absolute/path/to/certificate.pem
TELLER_KEY_PATH=/absolute/path/to/private_key.pem

# --- Plaid (legacy — removed in the Phase 3 cleanup PR) ---
PLAID_SANDBOX_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_CLIENT_ID=
PLAID_PRODUCTION_SECRET=

# --- Dev only (absent in production builds) ---
# DEV_AUTH_BYPASS_UID=test-user-active
# ADMIN_UIDS=test-user-active
